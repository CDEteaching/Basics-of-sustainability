@article{zhengConsiderationCultureVital2021,
  title = {Consideration of Culture Is Vital If We Are to Achieve the {{Sustainable Development Goals}}},
  author = {Zheng, Xinzhu and Wang, Ranran and Hoekstra, Arjen Y. and Krol, Maarten S. and Zhang, Yaxin and Guo, Kaidi and Sanwal, Mukul and Sun, Zhen and Zhu, Junming and Zhang, Junjie and Lounsbury, Amanda and Pan, Xunzhang and Guan, Dabo and Hertwich, Edgar G. and Wang, Can},
  year = {2021},
  month = feb,
  journal = {One Earth},
  volume = {4},
  number = {2},
  pages = {307--319},
  issn = {2590-3322},
  doi = {10.1016/j.oneear.2021.01.012},
  urldate = {2025-09-01},
  abstract = {Integrating the social and natural sciences to effectively tackle the intertwined challenges represented by the Sustainable Development Goals (SDGs) has been advocated for years. However, the practice is challenging, especially with respect to the beliefs, morals, and practices of individuals and groups or, more succinctly put, culture, which, despite attracting growing awareness, remains understated in sustainability. Here, we examine how and to what extent cultural values are linked to the achievement of the SDGs. Synthesizing knowledge from more than 300 publications, we show that cultural traits are linked to the achievement of all 17 SDGs and 79\% of SDG targets. Further, empirical understanding obtained from a panel data analysis highlights that cultural values explain as much as 26\% of the variations in the SDG achievements, yet the links are strikingly divergent across cultural traits and indicators. Our findings imply the need to consider more cultural contexts and nuances in sustainability science communications and policy design and to develop new cross-disciplinary solutions to sustainability challenges.},
  keywords = {2030 Agenda,connections,cross-disciplinary research,culture,individualism,SDGs,sustainable development,synergies,trade-offs,values},
  file = {C:\Users\Helen Perez\Zotero\storage\6Y7G5HWL\Zheng et al. - 2021 - Consideration of culture is vital if we are to ach.pdf}
}

