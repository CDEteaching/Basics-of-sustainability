@article{faImportanceIndigenousPeoples2020,
  title = {Importance of {{Indigenous Peoples}}' Lands for the Conservation of {{Intact Forest Landscapes}}},
  author = {Fa, Julia E and Watson, James EM and Leiper, Ian and Potapov, Peter and Evans, Tom D and Burgess, Neil D and Moln{\'a}r, Zsolt and {Fern{\'a}ndez-Llamazares}, {\'A}lvaro and Duncan, Tom and Wang, Stephanie and Austin, Beau J and Jonas, Harry and Robinson, Cathy J and Malmer, Pernilla and Zander, Kerstin K and Jackson, Micha V and Ellis, Erle and Brondizio, Eduardo S and Garnett, Stephen T},
