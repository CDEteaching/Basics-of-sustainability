@article{vallanceWhatSocialSustainability2011,
  title = {What Is Social Sustainability? {{A}} Clarification of Concepts},
  shorttitle = {What Is Social Sustainability?},
  author = {Vallance, Suzanne and Perkins, Harvey C. and Dixon, Jennifer E.},
  year = {2011},
  month = jun,
  journal = {Geoforum},
