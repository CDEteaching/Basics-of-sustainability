  shorttitle = {Enhancing {{Social Resilience}} of the {{Coastal Fishing Communities}}},
  author = {Mozumder, Mohammad Mojibul Hoque and Wahab, Md Abdul and Sarkki, Simo and Schneider, Petra and Islam, Mohammad Mahmudul},
  year = {2018},
